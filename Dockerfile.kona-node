# Build kona-node from a local checkout of optimism/rust/.
#
# Build context: /home/joshklop/repos/optimism, so both `rust/` and `op-core/`
# are visible to BuildKit. The kona-hardforks build.rs walks ancestors of
# CARGO_MANIFEST_DIR (= /workspace/kona/crates/protocol/hardforks) looking
# for op-core/nuts/bundles/karst_nut_bundle.json; placing op-core at
# /workspace/op-core satisfies that walk.

FROM rust:1.94-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      clang \
      cmake \
      libssl-dev \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Bring in the rust workspace and the NUT bundles next to it.
COPY rust/ /workspace/
COPY op-core/ /workspace/op-core/

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/workspace/target \
    cargo build --release --bin kona-node \
 && cp /workspace/target/release/kona-node /usr/local/bin/kona-node

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      libssl3 \
      curl \
      jq \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin/kona-node /usr/local/bin/kona-node
ENTRYPOINT ["kona-node"]
